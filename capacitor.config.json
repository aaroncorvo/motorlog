{
  "appId": "co.motorlog.app",
  "appName": "MotorLog",
  "webDir": "dist",
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SplashScreen": {
      "backgroundColor": "#0A0A0B",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0B"
    }
  },
  "ios": {
    "contentInset": "always"
  },
  "server": {
    "androidScheme": "https"
  }
}